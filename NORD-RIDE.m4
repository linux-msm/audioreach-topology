include(`audioreach/audioreach.m4')
include(`audioreach/stream-subgraph.m4')

include(`audioreach/device-subgraph.m4')
include(`util/route.m4')
include(`util/mixer.m4')
include(`audioreach/tokens.m4')

dnl Playback MultiMedia1
STREAM_SG_PCM_ADD(audioreach/subgraph-stream-vol-playback.m4, FRONTEND_DAI_MULTIMEDIA1,
	`S16_LE', 48000, 48000, 2, 2,
	0x00004001, 0x00004001, 0x00006001, `110000')

dnl Capture MultiMedia2
STREAM_SG_PCM_ADD(audioreach/subgraph-stream-capture.m4, FRONTEND_DAI_MULTIMEDIA2,
       `S16_LE', 48000, 48000, 1, 2,
       0x00004003, 0x00004003, 0x00006020, `110000')

dnl DAC Playback
DEVICE_AUDIO_IF_SG_ADD(audioreach/subgraph-device-audio-if-playback.m4, `AIF RX8 TDM8', AIF_TDM_RX_8,
	`S16_LE', 48000, 48000, 2, 2,
	LPAIF_INTF_TYPE_AUD, AUD_INTF_IDX_8, 0, DATA_FORMAT_FIXED_POINT,
	0x00004040, 0x00004040, 0x00006040, `AIF_TDM_RX_8',
	AUDIO_IF_SYNC_SRC_INTERNAL, AUDIO_IF_CTRL_DATA_OE_ENABLE,
	0x3, 0x8, 32,
	AUDIO_IF_INTF_MODE_TDM, AUDIO_IF_FRAME_SYNC_MODE_LONG_SYNC,
	AUDIO_IF_CTRL_INVERT_SYNC_PULSE_DISABLE,
	AUDIO_IF_CTRL_SYNC_DATA_DELAY_ENABLE,
	AUDIO_IF_TYPE_QAIF, AUDIO_IF_LANE_MASK_1, 0,
	AUDIO_IF_I_BIT_CLK_EN, AUDIO_IF_INT_CLK_INVERT,
	AUDIO_IF_EXT_CLK_NORMAL)

dnl ADC capture
DEVICE_AUDIO_IF_SG_ADD(audioreach/subgraph-device-audio-if-capture.m4, `AIF TX8 TDM8', AIF_TDM_TX_8,
       `S16_LE', 48000, 48000, 1, 2,
       LPAIF_INTF_TYPE_AUD, AUD_INTF_IDX_8, 0, DATA_FORMAT_FIXED_POINT,
       0x00004050, 0x00004050, 0x00006050, `AIF_TDM_TX_8',
       AUDIO_IF_SYNC_SRC_INTERNAL, AUDIO_IF_CTRL_DATA_OE_ENABLE,
       0x03, 0x8, 32,
       AUDIO_IF_INTF_MODE_TDM, AUDIO_IF_FRAME_SYNC_MODE_LONG_SYNC,
       AUDIO_IF_CTRL_INVERT_SYNC_PULSE_DISABLE,
       AUDIO_IF_CTRL_SYNC_DATA_DELAY_ENABLE,
       AUDIO_IF_TYPE_QAIF, AUDIO_IF_LANE_MASK_0, 0,
       AUDIO_IF_I_BIT_CLK_EN, AUDIO_IF_INT_CLK_INVERT,
       AUDIO_IF_EXT_CLK_NORMAL)


STREAM_DEVICE_CAPTURE_MIXER(FRONTEND_DAI_MULTIMEDIA2, ``AIF_TDM_TX_8'')
STREAM_DEVICE_CAPTURE_ROUTE(FRONTEND_DAI_MULTIMEDIA2, ``MultiMedia2 Mixer'', ``AIF_TDM_TX_8, device196.logger1'')

STREAM_DEVICE_PLAYBACK_MIXER(AIF_TDM_RX_8, ``AIF_TDM_RX_8'', ``MultiMedia1'')
STREAM_DEVICE_PLAYBACK_ROUTE(AIF_TDM_RX_8, ``AIF_TDM_RX_8 Audio Mixer'', ``MultiMedia1, stream0.logger1'')
