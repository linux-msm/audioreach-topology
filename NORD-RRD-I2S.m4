       0x03, 2, 16,
       AUDIO_IF_INTF_MODE_I2S, AUDIO_IF_FRAME_SYNC_MODE_SHORT_SYNC,
       0, 1,
       AUDIO_IF_TYPE_QAIF, AUDIO_IF_LANE_MASK_0, 0,
       AUDIO_IF_I_BIT_CLK_EN, AUDIO_IF_INT_CLK_NORMAL,
       AUDIO_IF_EXT_CLK_NORMAL)


STREAM_DEVICE_CAPTURE_MIXER(FRONTEND_DAI_MULTIMEDIA2, ``TERTIARY_MI2S_TX'')
STREAM_DEVICE_CAPTURE_ROUTE(FRONTEND_DAI_MULTIMEDIA2, ``MultiMedia2 Mixer'', ``TERTIARY_MI2S_TX, device21.logger1'')

STREAM_DEVICE_PLAYBACK_MIXER(TERTIARY_MI2S_RX, ``TERTIARY_MI2S_RX'', ``MultiMedia1'')
